{
    "name": "react-mobx-bootstrap-ts",
    "version": "2.0.0",
    "description": "React project scaffold based on TypeScript, MobX & Bootstrap, which is inspired by WebCell scaffold.",
    "author": "shiy2008@gmail.com",
    "dependencies": {
        "browser-fs-access": "^0.38.0",
        "browser-unhandled-rejection": "^1.0.2",
        "echarts-jsx": "^1.3.1",
        "idea-react": "^3.0.0-rc.2",
        "koajax": "^3.3.1",
        "lodash": "^4.18.1",
        "marked": "^18.2.0",
        "mobx": "^7.1.6",
        "mobx-downloader": "^0.3.5",
        "mobx-github": "^0.7.1",
        "mobx-i18n": "^0.7.9",
        "mobx-react": "^10.0.3",
        "mobx-restful": "^2.1.5",
        "mobx-restful-table": "^3.0.0-rc.1",
        "preact": "^11.2.0",
        "preact-render-to-string": "^6.8.2",
        "react": "npm:@preact/compat@^18.3.2",
        "react-bootstrap-editor": "^3.0.0-rc.0",
        "react-dom": "npm:@preact/compat@^18.3.2",
        "react-element-to-jsx-string": "^18.0.0",
        "react-router-class-tools": "^0.2.3",
        "react-router-dom": "^7.18.5",
        "web-utility": "^4.8.1"
    },
    "devDependencies": {
        "@babel/runtime": "^7.29.14",
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-raw-url": "~2.16.4",
        "@parcel/transformer-less": "~2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-webmanifest": "~2.16.4",
        "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "buffer": "^6.0.3",
        "eslint": "^10.14.0",
        "eslint-idea2app-tsx": "^0.5.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "parcel": "~2.16.4",
        "parcel-transformer-mdx": "^0.4.2",
        "postcss": "^8.5.32",
        "prettier": "^3.10.0",
        "prettier-plugin-css-order": "^2.2.0",
        "process": "^0.11.10",
        "typescript": "~6.0.3",
        "workbox-cli": "^7.4.1"
    },
    "alias": {
        "react": "preact/compat",
        "react-dom": "preact/compat",
        "react/jsx-runtime": "preact/jsx-runtime"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4,
        "plugins": [
            "prettier-plugin-css-order",
            "@softonus/prettier-plugin-duplicate-remover"
        ]
    },
    "lint-staged": {
        "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
        "*.{js,mjs,ts,tsx}": "eslint --fix"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead",
    "@parcel/resolver-default": {
        "packageExports": true
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged  &&  tsc --noEmit",
        "clean": "rm -rf .parcel-cache/ dist/",
        "start": "npm run clean  &&  parcel src/index.html",
        "pack": "npm run clean  &&  parcel build src/index.html --public-url .",
        "build": "npm run pack  &&  workbox generateSW"
    }
}
