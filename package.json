{
    "name": "react-mobx-bootstrap-ts",
    "version": "1.1.1",
    "description": "React project scaffold based on TypeScript, MobX & Bootstrap, which is inspired by WebCell scaffold.",
    "author": "shiy2008@gmail.com",
    "dependencies": {
        "@editorjs/code": "^2.9.4",
        "@editorjs/editorjs": "^2.31.6",
        "@editorjs/header": "^2.8.9",
        "@editorjs/image": "^2.10.3",
        "@editorjs/link": "^2.6.2",
        "@editorjs/list": "^2.0.9",
        "@editorjs/paragraph": "^2.11.7",
        "@editorjs/quote": "^2.7.6",
        "browser-fs-access": "^0.38.0",
        "browser-unhandled-rejection": "^1.0.2",
        "echarts-jsx": "^1.3.1",
        "editorjs-html": "^4.0.5",
        "idea-react": "^2.2.2",
        "koajax": "^3.3.0",
        "lodash": "^4.18.1",
        "mobx": "^6.16.1",
        "mobx-downloader": "^0.3.1",
        "mobx-github": "^0.6.2",
        "mobx-i18n": "^0.7.2",
        "mobx-react": "^9.2.2",
        "mobx-restful": "^2.1.4",
        "mobx-restful-table": "^2.6.3",
        "preact": "^10.29.2",
        "react": "npm:@preact/compat@^18.3.2",
        "react-bootstrap": "^2.10.10",
        "react-bootstrap-editor": "^2.1.1",
        "react-dom": "npm:@preact/compat@^18.3.2",
        "react-editor-js": "^2.1.0",
        "react-router-class-tools": "^0.2.3",
        "react-router-dom": "^7.18.0",
        "web-utility": "^4.6.6"
    },
    "devDependencies": {
        "@babel/runtime": "^7.29.7",
        "@cspell/eslint-plugin": "^10.0.1",
        "@eslint/js": "^10.0.1",
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-raw-url": "~2.16.4",
        "@parcel/transformer-less": "~2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-webmanifest": "~2.16.4",
        "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "buffer": "^6.0.3",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-spellcheck": "^0.0.20",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.8",
        "parcel": "~2.16.4",
        "parcel-transformer-mdx": "^0.4.2",
        "postcss": "^8.5.15",
        "prettier": "^3.8.4",
        "prettier-plugin-css-order": "^2.2.0",
        "prismjs": "^1.30.0",
        "process": "^0.11.10",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.62.0",
        "workbox-cli": "^7.4.1"
    },
    "alias": {
        "react": "preact/compat",
        "react-dom": "preact/compat",
        "react/jsx-runtime": "preact/jsx-runtime"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4,
        "plugins": [
            "prettier-plugin-css-order",
            "@softonus/prettier-plugin-duplicate-remover"
        ]
    },
    "lint-staged": {
        "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
        "*.{js,mjs,ts,tsx}": "eslint --fix"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "@parcel/resolver-default": {
        "packageExports": true
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged",
        "clean": "rm -rf .parcel-cache/ dist/",
        "start": "npm run clean  &&  parcel src/index.html",
        "pack": "npm run clean  &&  parcel build src/index.html --public-url .",
        "build": "npm run pack  &&  workbox generateSW"
    }
}
