    s4c3161035f3a1413: "\u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF \u03BC\u03B5\u03BD\u03BF\u03CD",
    s4e1e10a6ca408245: '\u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 "\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03C3\u03C4\u03B7\u03BD \u03BF\u03B8\u03CC\u03BD\u03B7 \u0391\u03C6\u03B5\u03C4\u03B7\u03C1\u03AF\u03B1\u03C2"',
    s6196153c4b0c1ea0: "\u0395\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7",
