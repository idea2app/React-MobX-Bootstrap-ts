    s9c63a79ffcc2a3a3: '\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 "\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629"',
    sa2d71bfd9525168d: '\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 "\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 Dock"',
    sa5ef80b4bb9b39f8: "\u0623\u0642\u0644",
    sb527eca1c1d7e7be: "\u0627\u0641\u062A\u062D \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u062A\u0635\u0641\u062D \u062F\u0627\u062E\u0644 \u0627\u0644\u062A\u0637\u0628\u064A\u0642",
    sba52286c21552a4e: "\u062B\u0628\u0651\u062A\u0647 \u0639\u0644\u0649 \u062C\u0647\u0627\u0632\u0643 \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649 \u062A\u062C\u0631\u0628\u0629 \u0634\u0627\u0645\u0644\u0629 \u0648\u0648\u0635\u0648\u0644 \u0633\u0647\u0644.",
    sc16e00a7a8b2fde2: "\u0631\u062C\u0648\u0639",
    scdaf4bbff76674c8: "\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629",
    sd18a5b85f599ff3c: "\u0627\u0641\u062A\u062D \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0646\u0633\u0648\u062E \u0641\u064A Safari",
    se72fc3a84f9b51c3: "\u0627\u0636\u063A\u0637 \u0644\u0646\u0633\u062E \u0627\u0644\u0631\u0627\u0628\u0637",
    se740f75b95a51807: "\u0623\u0636\u0641\u0647 \u0625\u0644\u0649 \u0634\u0631\u064A\u0637 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649 \u062A\u062C\u0631\u0628\u0629 \u0634\u0627\u0645\u0644\u0629 \u0648\u0648\u0635\u0648\u0644 \u0633\u0647\u0644.",
    sfa6c42cdf48d93d2: "\u0644\u0643\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u062A\u0635\u0641\u062D \u0644\u0627 \u064A\u062F\u0639\u0645 \u0630\u0644\u0643. \u0627\u0641\u062A\u062D \u0627\u0644\u0631\u0627\u0628\u0637 \u0641\u064A \u0645\u062A\u0635\u0641\u062D \u062E\u0627\u0631\u062C\u064A \u0644\u0644\u0645\u062A\u0627\u0628\u0639\u0629.",
    sfb78526365796a41: '\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 "\u0639\u0631\u0636 \u0627\u0644\u0645\u0632\u064A\u062F" \u0641\u064A \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629',
    sfea652f6580ff086: "\u064A\u062A\u0645\u062A\u0639 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0628\u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u062A\u0637\u0628\u064A\u0642."
}, $f88615c80acb9014$var$fe = {
    s05b70c60d4ea8317: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u201E\u041E\u0442\u0432\u0430\u0440\u044F\u043D\u0435 \u0432 \u0431\u0440\u0430\u0443\u0437\u044A\u0440\u2026\u201C",
    s182ab2d6c997515f: "\u0414\u043E\u0431\u0430\u0432\u0435\u0442\u0435 \u0433\u043E \u043A\u044A\u043C \u043D\u0430\u0447\u0430\u043B\u043D\u0438\u044F \u0441\u0438 \u0435\u043A\u0440\u0430\u043D \u0437\u0430 \u043F\u043E-\u0434\u043E\u0431\u0440\u043E \u043F\u0440\u0435\u0436\u0438\u0432\u044F\u0432\u0430\u043D\u0435 \u0438 \u043B\u0435\u0441\u0435\u043D \u0434\u043E\u0441\u0442\u044A\u043F.",
    s224cbcec014ef6b5: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u201E\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u201C \u0432 \u043B\u0435\u043D\u0442\u0430\u0442\u0430 \u0437\u0430 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F.",
    s233af3b7eb5e0364: "\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u044A\u043C \u043D\u0430\u0447\u0430\u043B\u043D\u0430\u0442\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430",
    s37a9e8aec5713460: "\u0420\u0430\u0437\u0448\u0438\u0440\u0438",
    s4c3161035f3a1413: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u043C\u0435\u043D\u044E\u0442\u043E",
    s4e1e10a6ca408245: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u201E\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u044A\u043C \u043D\u0430\u0447\u0430\u043B\u043D\u0438\u044F \u0435\u043A\u0440\u0430\u043D\u201C",
    s6196153c4b0c1ea0: "\u0418\u043D\u0441\u0442\u0430\u043B\u0438\u0440\u0430\u0439\u0442\u0435",
    s633502f7cff4f847: "\u041E\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u043C\u0435\u043D\u044E\u0442\u043E \u043D\u0430 \u0431\u0440\u0430\u0443\u0437\u044A\u0440\u0430 \u0441\u0438",
    s681e399d63311fba: "\u041F\u043E\u043A\u0430\u0436\u0438 \u0433\u0430\u043B\u0435\u0440\u0438\u044F",
    s6d14a4f70ba4e3cf: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u043C\u0435\u043D\u044E\u0442\u043E, \u0430\u043A\u043E \u043D\u044F\u043C\u0430 \u0438\u043A\u043E\u043D\u0430 \u201E\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u201C",
    s922329d6f6213590: "\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u044A\u043C Dock",
    s9c63a79ffcc2a3a3: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u201E\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u044A\u043C \u043D\u0430\u0447\u0430\u043B\u043D\u0438\u044F \u0435\u043A\u0440\u0430\u043D\u201C",
    sa2d71bfd9525168d: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u201E\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u044A\u043C Dock\u201C",
    sa5ef80b4bb9b39f8: "\u0421\u0432\u0438\u0439",
    sb527eca1c1d7e7be: "\u041E\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u043C\u0435\u043D\u044E\u0442\u043E \u043D\u0430 \u0432\u0433\u0440\u0430\u0434\u0435\u043D\u0438\u044F \u0431\u0440\u0430\u0443\u0437\u044A\u0440",
    sba52286c21552a4e: "\u0418\u043D\u0441\u0442\u0430\u043B\u0438\u0440\u0430\u0439\u0442\u0435 \u0433\u043E \u043D\u0430 \u0432\u0430\u0448\u0435\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0437\u0430 \u043F\u043E-\u043F\u044A\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E \u0438\u0437\u0436\u0438\u0432\u044F\u0432\u0430\u043D\u0435 \u0438 \u043F\u043E-\u043B\u0435\u0441\u0435\u043D \u0434\u043E\u0441\u0442\u044A\u043F.",
    sc16e00a7a8b2fde2: "\u041D\u0430\u0437\u0430\u0434",
    scdaf4bbff76674c8: "\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u044A\u043C \u043D\u0430\u0447\u0430\u043B\u043D\u0438\u044F \u0435\u043A\u0440\u0430\u043D",
    sd18a5b85f599ff3c: "\u041E\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u043A\u043E\u043F\u0438\u0440\u0430\u043D\u0430\u0442\u0430 \u0432\u0440\u044A\u0437\u043A\u0430 \u0432 Safari",
    se72fc3a84f9b51c3: "\u0414\u043E\u043A\u043E\u0441\u043D\u0435\u0442\u0435, \u0437\u0430 \u0434\u0430 \u043A\u043E\u043F\u0438\u0440\u0430\u0442\u0435 \u0432\u0440\u044A\u0437\u043A\u0430\u0442\u0430",
    se740f75b95a51807: "\u0414\u043E\u0431\u0430\u0432\u0435\u0442\u0435 \u0433\u043E \u043A\u044A\u043C Dock \u0437\u0430 \u043F\u043E-\u043F\u044A\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E \u043F\u0440\u0435\u0436\u0438\u0432\u044F\u0432\u0430\u043D\u0435 \u0438 \u043F\u043E-\u043B\u0435\u0441\u0435\u043D \u0434\u043E\u0441\u0442\u044A\u043F.",
    sfa6c42cdf48d93d2: "\u041D\u043E \u0442\u043E\u0437\u0438 \u0431\u0440\u0430\u0443\u0437\u044A\u0440 \u043D\u0435 \u0433\u043E \u043F\u043E\u0434\u0434\u044A\u0440\u0436\u0430. \u041E\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u0432\u0440\u044A\u0437\u043A\u0430\u0442\u0430 \u0432\u044A\u0432 \u0432\u044A\u043D\u0448\u0435\u043D \u0431\u0440\u0430\u0443\u0437\u044A\u0440, \u0437\u0430 \u0434\u0430 \u043F\u0440\u043E\u0434\u044A\u043B\u0436\u0438\u0442\u0435.",
    sfb78526365796a41: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u201E\u041F\u0440\u0435\u0433\u043B\u0435\u0434 \u043D\u0430 \u043E\u0449\u0435\u201C \u0432 \u043C\u0435\u043D\u044E\u0442\u043E \u201E\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u201C",
    sfea652f6580ff086: "\u0422\u043E\u0437\u0438 \u0441\u0430\u0439\u0442 \u0440\u0430\u0431\u043E\u0442\u0438 \u043A\u0430\u0442\u043E \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435."
}, $f88615c80acb9014$var$he = {
    s05b70c60d4ea8317: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xab\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435\u2026\xbb",
    s182ab2d6c997515f: "\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0435\u0433\u043E \u043D\u0430 \u044D\u043A\u0440\u0430\u043D \xab\u0414\u043E\u043C\u043E\u0439\xbb \u2014 \u044D\u0442\u043E \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0443\u0434\u043E\u0431\u043D\u0435\u0435.",
    s224cbcec014ef6b5: '\u041D\u0430\u0436\u043C\u0438\u0442\u0435 "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F"',
    s233af3b7eb5e0364: "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u044F\u0440\u043B\u044B\u043A \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D",
    s37a9e8aec5713460: "\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435",
    s4c3161035f3a1413: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xab\u041C\u0435\u043D\u044E\xbb",
    s4e1e10a6ca408245: '\u041D\u0430\u0436\u043C\u0438\u0442\u0435 "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"',
    s6196153c4b0c1ea0: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C",
    s633502f7cff4f847: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043C\u0435\u043D\u044E \u0432\u0430\u0448\u0435\u0433\u043E \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430",
    s681e399d63311fba: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0433\u0430\u043B\u0435\u0440\u0435\u044E",
    s6d14a4f70ba4e3cf: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xab\u041C\u0435\u043D\u044E\xbb, \u0435\u0441\u043B\u0438 \u043D\u0435\u0442 \u0437\u043D\u0430\u0447\u043A\u0430 \xab\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F\xbb",
    s922329d6f6213590: "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0432 Dock",
    s9c63a79ffcc2a3a3: '\u041D\u0430\u0436\u043C\u0438\u0442\u0435 "\u041D\u0430 \u044D\u043A\u0440\u0430\u043D \xab\u0414\u043E\u043C\u043E\u0439\xbb"',
    sa2d71bfd9525168d: '\u041D\u0430\u0436\u043C\u0438\u0442\u0435 "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0432 Dock"',
    sa5ef80b4bb9b39f8: "\u0421\u0432\u0435\u0440\u043D\u0443\u0442\u044C",
    sb527eca1c1d7e7be: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043C\u0435\u043D\u044E \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430",
    sba52286c21552a4e: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u044D\u0442\u043E \u043D\u0430 \u0432\u0430\u0448\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F.",
    sc16e00a7a8b2fde2: "\u041D\u0430\u0437\u0430\u0434",
    scdaf4bbff76674c8: "\u041D\u0430 \u044D\u043A\u0440\u0430\u043D \xab\u0414\u043E\u043C\u043E\u0439\xbb",
    sd18a5b85f599ff3c: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0441\u0441\u044B\u043B\u043A\u0443 \u0432 Safari",
    se72fc3a84f9b51c3: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u0441\u044B\u043B\u043A\u0443",
    se740f75b95a51807: "\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0435\u0433\u043E \u0432 Dock \u2014 \u044D\u0442\u043E \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0443\u0434\u043E\u0431\u043D\u0435\u0435.",
